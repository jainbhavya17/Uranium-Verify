APP_ENV=development
AUTH_ADAPTER=demo
DATABASE_URL=sqlite:///./var/uranium.db
STORAGE_ROOT=var/private
DEMO_PASSWORD=
COOKIE_SECURE=false
LOCAL_RECOVERY_PREVIEW=false
MALWARE_SCANNER=unavailable
CLAMSCAN_PATH=clamscan
CLAMAV_DATABASE=
TESSERACT_PATH=tesseract
OCR_LANGUAGE=eng
RAG_EMBEDDINGS_ENABLED=false
# Frontend public configuration (never put secrets in VITE_ variables).
# Vercel: set VITE_API_URL=https://uranium-verify-api.onrender.com
# Local development: use http://127.0.0.1:8014, or leave blank for the Vite proxy.
VITE_API_URL=
VITE_API_BASE_URL=/api/v1
# Exact comma-separated origins. Add a particular Vercel preview origin if needed.
CORS_ALLOWED_ORIGINS=https://uraniumverify.vercel.app,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5184,http://127.0.0.1:5184
